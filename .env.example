# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# --- Website address (used in email links) ---------------------------------
NEXT_PUBLIC_SITE_URL=https://www.newforestestatemanagement.co.uk
# Optional: shown on the public website if set
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- First admin login: the email allowed to use /setup ----------------------
ADMIN_SETUP_EMAIL=

# --- Resend (resend.com → API Keys) -----------------------------------------
RESEND_API_KEY=
EMAIL_FROM="New Forest Estate Management <bookings@newforestestatemanagement.co.uk>"
# Optional: where customer replies go if Settings → Business email is empty
EMAIL_REPLY_TO=

# --- Notion (notion.so/profile/integrations → Internal integration secret) ---
NOTION_TOKEN=

# --- WhatsApp: Green-API (free Developer plan) -------------------------------
GREENAPI_INSTANCE_ID=
GREENAPI_API_TOKEN=
# The "apiUrl" shown for your instance in the Green-API console
GREENAPI_API_URL=https://api.green-api.com

# --- WhatsApp: Whapi.Cloud (alternative, paid) -------------------------------
WHAPI_TOKEN=
